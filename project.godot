[layer_names]

2d_physics/layer_1="All"
2d_physics/layer_2="Platforms"
2d_physics/layer_3="BeeBody"
2d_physics/layer_4="Ground"
2d_physics/layer_5="Pickups"
2d_physics/layer_6="BuildBlock"
2d_physics/layer_7="Active Platforms"
2d_physics/layer_8="Lander"
2d_physics/layer_9="Decorations"
2d_physics/layer_10="Breakables"
2d_physics/layer_11="Buttons"
2d_physics/layer_12="Worms"
2d_physics/layer_13="Spit"
2d_physics/layer_14="Bird"
2d_physics/layer_15="Bombs"
2d_physics/layer_16="Rocks"
2d_physics/layer_17="Bird Bodies"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
